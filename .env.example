# ============================================================
# ElevateMe Referral Program — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. It is gitignored.
# ============================================================

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Prisma — PostgreSQL via Supabase pooler)
# Use port 6543 for runtime (PgBouncer), port 5432 for migrations (direct)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32-output

# Bank detail encryption key (for encrypting bankAccount / bankIfsc / upiId at rest)
# Generate with: openssl rand -base64 32
BANK_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output

# Email service (optional — defaults to log-only mode)
EMAIL_SERVICE=log
EMAIL_FROM=ElevateMe <noreply@yourdomain.com>
# Resend (recommended): https://resend.com/api-keys
RESEND_API_KEY=
# SendGrid: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Vercel Cron secret (used by /api/cron/* endpoints)
# Generate with: openssl rand -base64 32
# Set this in Vercel env vars. Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` header on cron requests.
CRON_SECRET=replace-with-openssl-rand-base64-32-output

# App URL (used in emails and redirects)
APP_URL=http://localhost:3000

# CORS — comma-separated list of origins allowed to call /api/track
# and /api/referral cross-origin (e.g. from partner websites).
# Same-origin requests are always allowed regardless of this list.
ALLOWED_ORIGINS=http://localhost:3000
